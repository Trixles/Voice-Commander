# -- Python build artifacts --------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# -- Virtual environments ----------------------------------------------------
venv/
.venv/
env/
ENV/

# -- Distribution / packaging ------------------------------------------------
build/
dist/
*.egg-info/
*.egg
wheels/
share/python-wheels/

# -- IDE / editor -------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# -- Local context ------------------------------------------------------------
# AI assistant session memory, config, and discussion docs. Not project
# documentation -- kept out of the repo intentionally so working style and
# session-scoped notes don't leak.
HANDOFF.md
CLAUDE.md
REVIEW.md
.claude/

# User's personal command config. The default config is generated by
# install.sh via `python -m core.commands --emit-defaults`, so the repo
# does not need to ship a commands.json. Keep your personal copy somewhere
# outside the repo if you want a backup.
commands.json

# -- Logs / temp --------------------------------------------------------------
*.log
*.tmp
