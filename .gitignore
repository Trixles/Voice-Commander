# -- Python build artifacts --------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# -- Virtual environments ----------------------------------------------------
venv/
.venv/
env/
ENV/

# -- Distribution / packaging ------------------------------------------------
build/
dist/
*.egg-info/
*.egg
wheels/
share/python-wheels/

# -- IDE / editor -------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# -- Local context ------------------------------------------------------------
# Session-scoped working memory only. Everything else Claude-related
# (CLAUDE.md, .claude/, etc.) is tracked -- this project was built with
# Claude Code and there's no reason to hide that.
HANDOFF.md
.claude/worktrees/

# User's personal command config. The default config is generated by
# install.sh via `python -m core.commands --emit-defaults`, so the repo
# does not need to ship a commands.json. Keep your personal copy somewhere
# outside the repo if you want a backup.
commands.json

# -- Whisper benchmark scratch (models + recorded samples, hundreds of MB) ----
# `benchmark/*`, NOT `benchmark/` -- git does not descend into an ignored
# DIRECTORY, so a trailing-slash form makes the negation below impossible.
# The trainer is tracked because it is the only means of rebuilding the
# wake verifier .pkl; it must stay dependency-free of its untracked
# neighbours (see the inlined helpers at the top of it).
benchmark/*
!benchmark/train_v2_verifier.py

# -- Logs / temp --------------------------------------------------------------
*.log
*.tmp

# -- Local diagnostic tools (kept on disk, not shipped) -----------------------
# Reusable debug/test scripts that aren't part of the app: matcher danger-map
# (bug-c probe), offscreen Restore-Defaults smoke test, etc.
tools/
