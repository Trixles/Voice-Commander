# -- Python build artifacts --------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# -- Virtual environments ----------------------------------------------------
venv/
.venv/
env/
ENV/

# -- Distribution / packaging ------------------------------------------------
build/
dist/
*.egg-info/
*.egg
wheels/
share/python-wheels/

# -- IDE / editor -------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# -- Local context ------------------------------------------------------------
# Session-scoped working memory only. Everything else Claude-related
# (CLAUDE.md, .claude/, etc.) is tracked -- this project was built with
# Claude Code and there's no reason to hide that.
HANDOFF.md
.claude/worktrees/

# User's personal command config. The default config is generated by
# install.sh via `python -m core.commands --emit-defaults`, so the repo
# does not need to ship a commands.json. Keep your personal copy somewhere
# outside the repo if you want a backup.
commands.json

# -- Benchmark scratch (models + recorded samples, hundreds of MB) ------------
# Local evaluation material only (whisper spikes, retired oww corpus kept
# as possible Home Assistant material) -- nothing in here is tracked.
benchmark/*

# -- Logs / temp --------------------------------------------------------------
*.log
*.tmp

# -- Local diagnostic tools (kept on disk, not shipped) -----------------------
# Reusable debug/test scripts that aren't part of the app: matcher danger-map
# (bug-c probe), offscreen Restore-Defaults smoke test, etc.
tools/
