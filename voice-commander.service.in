# Voice Commander -- systemd user service
#
# This file is a TEMPLATE. The install script substitutes @VENV_PYTHON@ and
# @APP_DIR@ with real absolute paths at install time, then writes the result
# to ~/.config/systemd/user/voice-commander.service.
#
# Do not copy this file directly into ~/.config/systemd/user/ -- it won't run
# until the placeholders are resolved.

[Unit]
Description=Voice Commander
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
# Ensure xvf_host (~/.local/bin) is reachable. systemd user services don't
# inherit PATH from the user's shell; without this, LED control silently
# disables itself when xvf_host isn't in the default service PATH.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=@VENV_PYTHON@ @APP_DIR@/voice_commander.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
